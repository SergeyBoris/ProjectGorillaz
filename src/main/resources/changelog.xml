    <changeSet id="13-05-2025-21-03-10-many_to_many_requests_equipments_montage" author="borisov">
        <createTable tableName="requests_equipments_montage">
            <column name="request_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="equipment_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="requests_equipments_montage"
                baseColumnNames="request_id"
                referencedTableName="requests"
                referencedColumnNames="request_id"
                constraintName="fk_requests_equipments_montage_request"/>

        <addForeignKeyConstraint
                baseTableName="requests_equipments_montage"
                baseColumnNames="equipment_id"
                referencedTableName="equipments"
                referencedColumnNames="equipment_id"
                constraintName="fk_requests_equipments_montage_equipment"/>
    </changeSet>

    <changeSet id="13-05-2025-23-25-10-many_to_many_requests_equipments_unmontage" author="borisov">
        <createTable tableName="requests_equipments_unmontage">
            <column name="request_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="equipment_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="requests_equipments_unmontage"
                baseColumnNames="request_id"
                referencedTableName="requests"
                referencedColumnNames="request_id"
                constraintName="fk_requests_equipments_unmontage_request"/>

        <addForeignKeyConstraint
                baseTableName="requests_equipments_unmontage"
                baseColumnNames="equipment_id"
                referencedTableName="equipments"
                referencedColumnNames="equipment_id"
                constraintName="fk_requests_equipments_unmontage_equipment"/>
    </changeSet>
    <changeSet id="19-05-2025-15-28-10-add-request-status-index" author="borisov">
        <createIndex
                indexName="idx_request_status"
                tableName="requests">
            <column name="request_status"/>
        </createIndex>
    </changeSet>


</databaseChangeLog>