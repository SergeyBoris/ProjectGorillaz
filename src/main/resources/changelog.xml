    <changeSet id="24-02-2025-21-13-10-add-contragents" author="borisov">
        <createTable tableName="contragents">
            <column name="contragent_id" type="BIGINT AUTO_INCREMENT">
                <constraints primaryKey="true"/>
            </column>
            <column name="contragent_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="24-02-2025-21-13-10-add-contragents-values" author="borisov">
        <insert tableName="contragents">
            <column name="contragent_name" value="Страйк"/>
        </insert>
        <insert tableName="contragents">
            <column name="contragent_name" value="ПБФ"/>
        </insert>
        <insert tableName="contragents">
            <column name="contragent_name" value="Engy"/>
        </insert>
        <insert tableName="contragents">
            <column name="contragent_name" value="Hendz"/>
        </insert>
    </changeSet>

    <changeSet id="24-02-2025-21-13-10-add-equipments" author="borisov">
        <createTable tableName="equipments">
            <column name="equipment_id" type="BIGINT AUTO_INCREMENT">
                <constraints primaryKey="true"/>
            </column>
            <column name="model" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="serial_number" type="varchar(255)">
                <constraints nullable="true" unique="true"/>
            </column>
            <column name="equipment_status" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="13-05-2025-19-23-10-create-users-table" author="borisov">

        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="mail" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="password" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="role" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

    </changeSet>

    <changeSet id="24-02-2025-21-13-10-add-requests" author="borisov">
        <createTable tableName="requests">
            <column name="request_id" type="BIGINT AUTO_INCREMENT">
                <constraints primaryKey="true"/>
            </column>
            <column name="req_number" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="customer" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="customer_phone" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="customer_address" type="text">
                <constraints nullable="true"/>
            </column>
            <column name="sla" type="timestamp">
                <constraints nullable="true"/>
            </column>
            <column name="closed_date" type="timestamp">
                <constraints nullable="true"/>
            </column>
            <column name="create_date" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="last_update" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="comment" type="text">
                <constraints nullable="true"/>
            </column>
            <column name="link_to_akt_file" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="request_status" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="contragent_id" type="bigint">
                <constraints nullable="true" foreignKeyName="requests_contragents_contragent_id_fk"
                             references="contragents(contragent_id)"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="requests_users_id_fk"
                             referencedTableName="users" referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>

